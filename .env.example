# Postgres from docker-compose.yml
DATABASE_URL=postgres://mockingbird:mockingbird@localhost:5433/mockingbird

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://console.deepgram.com (voice mode: Flux speech-to-text and Aura-2 text-to-speech)
DEEPGRAM_API_KEY=

# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional sign-in providers. Each turns on when both its values are set.
# Google: https://console.cloud.google.com/apis/credentials
#   redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
#   callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Practice plan videos: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
