{
  "name": "mockingbird",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "worker": "node --env-file=.env.local --import tsx src/worker/index.ts",
    "voice": "node --env-file=.env.local --import tsx src/voice/server.ts",
    "voice:bench": "node --env-file=.env.local --import tsx scripts/voice-bench.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "resources:refresh": "node --env-file=.env.local --import tsx scripts/refresh-resources.ts",
    "claim-interviews": "node --env-file=.env.local --import tsx scripts/claim-interviews.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@tessera/react": "file:vendor/tessera-react-0.1.0.tgz",
    "@tessera/tokens": "file:vendor/tessera-tokens-0.1.0.tgz",
    "better-auth": "^1.7.11",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
